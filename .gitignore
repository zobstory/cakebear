# cakebear owns this file: upstream (microsoft/TypeScript) keeps its
# .gitignore at the monorepo root, outside the tsc/ tree cakebear syncs. These
# are the rules from it that apply to the Go tree, with tsc/ stripped from their
# paths, plus cakebear's own conventions.

# cakebear builds binaries into bin/ (CLAUDE.md, "Build / test / run").
/bin
# CLIs built in place by a bare `go build`.
/cakec
/tsc
/cmd/tsc/tsc

# Go and native build outputs.
/go.work
/go.work.sum
*.exe
*.exe~
*.dll
*.so
*.dylib
*.wasm
*.test
__debug_bin*
*.out
*.prof
*.pb.gz
coverage
*.lcov

# Local compiler baselines and test output.
testdata/baselines/local
testdata/baselines/tmp

# Editors, the OS, local environment.
.DS_Store
.idea
**/.vscode/*
.env
.env.*

# Claude Code's local settings and worktrees. .claude/settings.json is tracked.
/.claude/settings.local.json
/.claude/worktrees/
